{
  "name": "@vfvrpq/dsh-search",
  "version": "0.1.0",
  "description": "DeepSeek first-party Search/Fetch API for DeepSeek Harness: three tools (deepseek_search / deepseek_fetch / deepseek_research) that return structured, reranked web results with search operators, page-to-Markdown fetching, and cost-aware defaults.",
  "type": "module",
  "license": "MIT",
  "author": "439436269-ctrl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/439436269-ctrl/dsh-search.git"
  },
  "homepage": "https://github.com/439436269-ctrl/dsh-search#readme",
  "bugs": {
    "url": "https://github.com/439436269-ctrl/dsh-search/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "search",
    "fetch",
    "web-search",
    "rag"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "CHANGELOG.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "selftest": "node scripts/live-selftest.js"
  }
}
